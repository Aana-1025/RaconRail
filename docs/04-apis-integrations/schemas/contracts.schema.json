{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reconrail:schema:contracts-v1",
  "title": "ReconRail v1 approved planning contracts",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "Money": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,37})$"
    },
    "Unsigned": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "x-maxInteger": "9223372036854775807"
    },
    "Positive": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "x-maxInteger": "9223372036854775807"
    },
    "Duration": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})$",
      "x-maxInteger": "315576000000000000"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Base64url without padding, exactly32 decoded bytes; decode/re-encode must match."
    },
    "ProviderNamespace": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "stripe"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 255
        },
        "sandboxId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 255
        },
        "livemode": {
          "const": false
        }
      },
      "required": [
        "provider",
        "accountId",
        "sandboxId",
        "livemode"
      ],
      "additionalProperties": false
    },
    "AppNamespace": {
      "type": "object",
      "properties": {
        "systemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 255
        },
        "environmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 255
        }
      },
      "required": [
        "systemId",
        "environmentId"
      ],
      "additionalProperties": false
    },
    "PurposeContext": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 1024
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "readStart": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "readEnd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "clockErrorUs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "PaymentIntent": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "payment_intent"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 255
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "captureMethod": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "amountReceived": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "amountCapturable": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "latestChargeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 255
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "observation"
      ],
      "additionalProperties": false
    },
    "Charge": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "charge"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 255
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "paymentIntentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "paid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "captured": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "disputed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "amountCaptured": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "amountRefunded": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actualMethodType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "observation"
      ],
      "additionalProperties": false
    },
    "Order": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "order"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 255
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "paymentReference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "paymentState": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "rawPaymentState": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedAmount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedCurrency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectationRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 255
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "observation"
      ],
      "additionalProperties": false
    },
    "ProviderArtifact": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "rr-evidence-v1"
        },
        "role": {
          "const": "provider"
        },
        "captureId": {
          "$ref": "#/$defs/Uuid"
        },
        "providerNamespace": {
          "$ref": "#/$defs/ProviderNamespace"
        },
        "appNamespace": {
          "$ref": "#/$defs/AppNamespace"
        },
        "sourceVersion": {
          "const": "2025-09-30.clover"
        },
        "exporterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 128
        },
        "capturedAt": {
          "$ref": "#/$defs/Instant"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "selected",
            "complete",
            "unknown"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/PaymentIntent"
              },
              {
                "$ref": "#/$defs/Charge"
              }
            ]
          },
          "maxItems": 10000
        }
      },
      "required": [
        "schemaVersion",
        "role",
        "captureId",
        "providerNamespace",
        "appNamespace",
        "sourceVersion",
        "exporterVersion",
        "capturedAt",
        "coverage",
        "records"
      ],
      "additionalProperties": false
    },
    "ApplicationArtifact": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "rr-evidence-v1"
        },
        "role": {
          "const": "application"
        },
        "captureId": {
          "$ref": "#/$defs/Uuid"
        },
        "providerNamespace": {
          "$ref": "#/$defs/ProviderNamespace"
        },
        "appNamespace": {
          "$ref": "#/$defs/AppNamespace"
        },
        "sourceVersion": {
          "const": "rr-app-export-v1"
        },
        "exporterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 128
        },
        "capturedAt": {
          "$ref": "#/$defs/Instant"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "selected",
            "complete",
            "unknown"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Order"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "schemaVersion",
        "role",
        "captureId",
        "providerNamespace",
        "appNamespace",
        "sourceVersion",
        "exporterVersion",
        "capturedAt",
        "coverage",
        "records"
      ],
      "additionalProperties": false
    },
    "FlowDeclarations": {
      "type": "object",
      "properties": {
        "oneTime": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fullOriginal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "automaticCapture": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "noAdjustments": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "noSubscription": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "noConnect": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "noSplit": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "oneTime",
        "fullOriginal",
        "automaticCapture",
        "noAdjustments",
        "noSubscription",
        "noConnect",
        "noSplit"
      ],
      "additionalProperties": false
    },
    "RunConfig": {
      "type": "object",
      "properties": {
        "graceUs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshnessLimitUs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "flowDeclarations": {
          "$ref": "#/$defs/FlowDeclarations"
        }
      },
      "required": [
        "flowDeclarations"
      ],
      "additionalProperties": false
    },
    "Digests": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Digest"
        },
        "application": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "provider",
        "application"
      ],
      "additionalProperties": false
    },
    "Versions": {
      "type": "object",
      "properties": {
        "rulesVersion": {
          "const": "stripe-card-order-v1"
        },
        "currencyVersion": {
          "const": "rr-currency-v1"
        },
        "normalizerVersion": {
          "const": "stripe-card-order-normalizer-v1"
        }
      },
      "required": [
        "rulesVersion",
        "currencyVersion",
        "normalizerVersion"
      ],
      "additionalProperties": false
    },
    "Namespaces": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderNamespace"
        },
        "application": {
          "$ref": "#/$defs/AppNamespace"
        }
      },
      "required": [
        "provider",
        "application"
      ],
      "additionalProperties": false
    },
    "Counts": {
      "type": "object",
      "properties": {
        "paymentIntents": {
          "$ref": "#/$defs/Unsigned"
        },
        "charges": {
          "$ref": "#/$defs/Unsigned"
        },
        "orders": {
          "$ref": "#/$defs/Unsigned"
        }
      },
      "required": [
        "paymentIntents",
        "charges",
        "orders"
      ],
      "additionalProperties": false
    },
    "CreateCase": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 1024
        },
        "purposeContext": {
          "$ref": "#/$defs/PurposeContext"
        },
        "providerNamespace": {
          "$ref": "#/$defs/ProviderNamespace"
        },
        "appNamespace": {
          "$ref": "#/$defs/AppNamespace"
        }
      },
      "required": [
        "purposeContext",
        "providerNamespace",
        "appNamespace"
      ],
      "additionalProperties": false
    },
    "PatchCase": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024,
              "pattern": "^[^\\u0000]*$",
              "x-maxUtf8Bytes": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "purposeContext": {
          "$ref": "#/$defs/PurposeContext"
        },
        "state": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "ARCHIVED"
          ]
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "StartRun": {
      "type": "object",
      "properties": {
        "inputVersionId": {
          "$ref": "#/$defs/Uuid"
        },
        "inputDigests": {
          "$ref": "#/$defs/Digests"
        },
        "reviewDigest": {
          "$ref": "#/$defs/Digest"
        },
        "rulesVersion": {
          "const": "stripe-card-order-v1"
        },
        "currencyVersion": {
          "const": "rr-currency-v1"
        },
        "normalizerVersion": {
          "const": "stripe-card-order-normalizer-v1"
        },
        "config": {
          "$ref": "#/$defs/RunConfig"
        },
        "referenceAt": {
          "$ref": "#/$defs/Instant"
        }
      },
      "required": [
        "inputVersionId",
        "inputDigests",
        "reviewDigest",
        "rulesVersion",
        "currencyVersion",
        "normalizerVersion",
        "config"
      ],
      "additionalProperties": false
    },
    "Confirm": {
      "type": "object",
      "properties": {
        "confirm": {
          "const": true
        }
      },
      "required": [
        "confirm"
      ],
      "additionalProperties": false
    },
    "DeleteCase": {
      "type": "object",
      "properties": {
        "expectedGeneration": {
          "$ref": "#/$defs/Positive"
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "expectedGeneration",
        "confirm"
      ],
      "additionalProperties": false
    },
    "CloseAccount": {
      "type": "object",
      "properties": {
        "closureConfirmation": {
          "$ref": "#/$defs/Secret"
        },
        "expectedGeneration": {
          "$ref": "#/$defs/Positive"
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "closureConfirmation",
        "expectedGeneration",
        "confirm"
      ],
      "additionalProperties": false
    },
    "LookupReceipt": {
      "type": "object",
      "properties": {
        "receipt": {
          "$ref": "#/$defs/Secret"
        }
      },
      "required": [
        "receipt"
      ],
      "additionalProperties": false
    },
    "ErrorEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 128
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^urn:reconrail:problem:[a-z_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 128
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 512
        },
        "instance": {
          "type": "string",
          "pattern": "^urn:uuid:"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 128
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErrorEntry"
          },
          "maxItems": 20
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "code",
        "requestId"
      ],
      "additionalProperties": true
    },
    "WorkspaceUsage": {
      "type": "object",
      "properties": {
        "quotaBytes": {
          "$ref": "#/$defs/Unsigned"
        },
        "usedBytes": {
          "$ref": "#/$defs/Unsigned"
        },
        "reservedBytes": {
          "$ref": "#/$defs/Unsigned"
        },
        "availableBytes": {
          "$ref": "#/$defs/Unsigned"
        },
        "accountingVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]*$",
          "x-maxUtf8Bytes": 128
        },
        "observedAt": {
          "$ref": "#/$defs/Instant"
        }
      },
      "required": [
        "quotaBytes",
        "usedBytes",
        "reservedBytes",
        "availableBytes",
        "accountingVersion",
        "observedAt"
      ],
      "additionalProperties": true
    },
    "Session": {
      "type": "object",
      "properties": {
